# Auto-accept legacy peer deps so `npm ci` works without flags.
# This is needed because the project pins typescript ~6.0.2 while
# madge@8 expects typescript ^5.4.4.  The actual build doesn't
# consume madge's types, so the conflict is informational only.
legacy-peer-deps=true

# Allow semver ranges on `npm install` (package.json uses ^ and ~ ranges)

# Avoid noisy funding output
fund=false

# M6 (3c): audit=false suppresses `npm audit` warnings. Trade-off:
# silent CI vs. catching known vulns early. Enable in CI pipelines.
audit=false
