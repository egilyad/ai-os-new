{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["node", "C:/Users/evgeny/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js"],
      "enabled": true
    },
    "aios-tasks": {
      "type": "local",
      "command": ["node", "./cli/tasks-mcp-server.mjs"],
      "environment": {
        "AIOS_SYNC_URL": "{env:AIOS_SYNC_URL}",
        "AIOS_SYNC_TOKEN": "{env:AIOS_SYNC_TOKEN}"
      },
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "write": "allow",
    "apply_patch": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "node scripts/opencode/*.mjs*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git stash list*": "allow"
    },
    "playwright_*": "ask",
    "aios-tasks_*": "allow"
  }
}
