{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["node", "C:/Users/evgeny/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "write": "allow",
    "apply_patch": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": "ask",
    "playwright_*": "ask"
  }
}
