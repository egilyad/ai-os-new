{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["node", "C:/Users/evgeny/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js"],
      "enabled": true
    },
    "aios-tasks": {
      "type": "local",
      "command": ["node", "./cli/tasks-mcp-server.mjs"],
      "environment": {
        "AIOS_SYNC_URL": "{env:AIOS_SYNC_URL}",
        "AIOS_SYNC_TOKEN": "{env:AIOS_SYNC_TOKEN}"
      },
      "enabled": true
    },
    "desk-mcp": {
      "type": "local",
      "command": ["node", "C:/Users/evgeny/AppData/Local/Programs/desk-mcp/server.mjs"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "edit": "allow",
    "write": "allow",
    "apply_patch": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git push --force*": "deny",
      "rm -rf*": "deny",
      "rm -r /*": "deny",
      "format *": "deny",
      "*opencode.db*": "deny"
    },
    "playwright_*": "allow",
    "aios-tasks_*": "allow",
    "computer_*": "allow"
  }
}
