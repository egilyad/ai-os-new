{
  "name": "ai-os-new",
  "private": true,
  "version": "4.5.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/theme-init*",
    "**/*.worker*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:skip-typecheck": "node -e \"console.error('WARNING: skipping typecheck — broken types will NOT fail this build. Prefer `npm run build` for CI/ship.')\" && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "sourcemaps:upload": "node scripts/upload-sourcemaps.mjs",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b --noEmit",
    "typecheck:fast": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit --project tsconfig.app.json",
    "typecheck:watch": "tsc -b --noEmit --watch",
    "fix:unused": "tsx scripts/fix-unused.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run src/stores src/hooks src/kernel/events src/kernel/workers src/kernel/container.test.ts --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "proxy": "node scripts/cors-proxy.mjs",
    "sync-server": "node server/sync-server.mjs",
    "dev:shared": "node server/run-dev.mjs",
    "preview": "vite preview",
    "check:circular-kernel": "madge --circular --extensions ts --ts-config tsconfig.app.json src/kernel/ 2>&1 | node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{console.log(d);if(/Found \\\\d+ circular/.test(d))process.exit(1)})\"",
    "check:deps": "depcruise --config .dependency-cruiser.cjs src",
    "check:deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > dependency-graph.svg",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@orama/orama": "^3.1.18",
    "@react-aria/focus": "^3.22.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@xyflow/react": "^12.10.2",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.4.0",
    "lucide-react": "^1.14.0",
    "meriyah": "^7.1.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.5",
    "commitlint": "^21.2.1",
    "dependency-cruiser": "18.0.0",
    "esbuild": "0.28.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.0.7",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "ws": "^8.21.0"
  }
}
