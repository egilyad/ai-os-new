# SuperAgents OS - Environment Configuration
# Copy this file to .env and fill in your values.
# This file is the SINGLE SOURCE OF TRUTH for all env-driven configuration.
# See vite.config.ts for default proxy targets when no env override is set.

# App Origin (used as HTTP-Referer header in LLM API calls)
VITE_APP_ORIGIN=http://localhost:5173

# Base path for the app (used by Vite base config and Dockerfile build-arg)
# Set to /repo-name/ when deploying to GitHub Pages project page
VITE_BASE_PATH=/

# Enable agent code execution sandbox (requires unsafe-eval CSP)
# WARNING: Only enable in production if you understand the security implications.
# The worker runner requires unsafe-eval — this weakens your CSP.
VITE_SANDBOX_ENABLED=false

# Build ID (injected at CI build time; identifies which build is running)
VITE_BUILD_ID=dev

# Provider Proxy Targets (dev server rewrites /proxy/:provider/*)
# Override defaults in vite.config.ts to route through a custom CORS proxy
VITE_PROXY_GEMINI=https://generativelanguage.googleapis.com
VITE_PROXY_OPENROUTER=https://openrouter.ai
VITE_PROXY_NVIDIA=https://integrate.api.nvidia.com
VITE_PROXY_GROQ=https://api.groq.com/openai/v1
VITE_PROXY_CEREBRAS=https://api.cerebras.ai/v1
VITE_PROXY_CLOUDFLARE=https://api.cloudflare.com/client/v4
VITE_PROXY_OPENAI=https://api.openai.com

# Fetch tool proxy (sandboxed URL fetching)
# Dev: /proxy/fetch routes here; fallback: run: npm run proxy (cors-proxy.mjs on :3002)
# Production: Set to /proxy/fetch relative to your domain
VITE_PROXY_FETCH=http://localhost:3002/fetch

# API upstream (for /api/* routes in dev)
VITE_API_UPSTREAM=https://api.openrouter.ai

# ── API Keys (for bulk import script scripts/insert-all-keys.ts) ──────────────
# Set these to populate keys via the insert-all-keys script.
# Unset variables are skipped — only configure the providers you use.
# WARNING: Never commit .env to version control.
# VITE_KEY_OPENROUTER_01=
# VITE_KEY_OPENROUTER_02=
# VITE_KEY_GEMINI_01=
# VITE_KEY_GEMINI_02=
# VITE_KEY_GEMINI_03=
# VITE_KEY_GROQ_01=
# VITE_KEY_GROQ_02=
# VITE_KEY_GROQ_03=
# VITE_KEY_NVIDIA_01=
# VITE_KEY_NVIDIA_02=
# VITE_KEY_DEEPSEEK_01=
# VITE_KEY_COMETAPI_01=
# VITE_KEY_COHERE_01=
# VITE_KEY_BLACKBOX_01=

# CORS Proxy (for sandboxed tool execution — fallback when direct fetch fails)
# Dev: run: npm run proxy (starts cors-proxy.mjs on port 3002)
# Production: Set to the nginx proxy endpoint (e.g., https://yourdomain.com/proxy/fetch)
# or the docker internal cors-proxy if using the companion service.
# Falls back to /proxy/fetch relative to the serving origin if unset.
VITE_PROXY_URL=http://localhost:3002/fetch

# ── Infrastructure (used by server/ and docker/) ──────────────────────────────
# Sync server WebSocket auth token — REQUIRED in production
# IMPORTANT: Generate a strong random token (e.g. openssl rand -hex 32)
# and NEVER commit it to version control. This is a placeholder only.
SYNC_SECRET=

# Sync server allowed origins (comma-separated)
SYNC_ORIGINS=http://localhost:5173

# CORS proxy allowed origin (used by scripts/cors-proxy.mjs)
CORS_ORIGIN=http://localhost:5173

# ── Docker / nginx (passed via docker run -e or docker-compose environment) ────
# API upstream (used in nginx /api/ location)
API_UPSTREAM=https://api.openrouter.ai

# Fetch tool proxy in Docker (nginx /proxy/fetch/* routes here)
# SEC-07: REQUIRED in production. Set to your own proxy endpoint.
# Default is empty — nginx will fail closed if not configured.
# PROXY_FETCH=/proxy/fetch

# Per-provider nginx proxy defaults (override at deploy time if needed)
# PROXY_GEMINI=https://generativelanguage.googleapis.com
# PROXY_OPENROUTER=https://openrouter.ai
# PROXY_NVIDIA=https://integrate.api.nvidia.com
# PROXY_GROQ=https://api.groq.com/openai/v1
# PROXY_CEREBRAS=https://api.cerebras.ai/v1
# PROXY_CLOUDFLARE=https://api.cloudflare.com/client/v4
# PROXY_GENERIC=https://api.openai.com
