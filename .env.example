# SuperAgents OS - Environment Configuration
# Copy this file to .env and fill in your values.
# This file is the SINGLE SOURCE OF TRUTH for all env-driven configuration.
# See vite.config.ts for default proxy targets when no env override is set.

# App Origin (used as HTTP-Referer header in LLM API calls)
VITE_APP_ORIGIN=http://localhost:5173

# Base path for the app (used by Vite base config and Dockerfile build-arg)
# Set to /repo-name/ when deploying to GitHub Pages project page
VITE_BASE_PATH=/

# Enable agent code execution sandbox (meriyah AST interpreter — does NOT
# require unsafe-eval CSP; never add unsafe-eval "for the sandbox").
# WARNING: Only enable in production if you understand the security implications.
VITE_SANDBOX_ENABLED=false

# Build ID (injected at CI build time; identifies which build is running)
VITE_BUILD_ID=dev

# Azure OpenAI base URL (optional — no /proxy/azure route exists by default,
# so Azure calls 403 unless you point this at your resource or proxy)
# VITE_AZURE_BASE_URL=https://{resource}.openai.azure.com/openai/deployments/{deployment}
# VITE_PROXY_AZURE=https://your-proxy/azure

# Debug flags (dev-only, undocumented previously — CF10-05)
# VITE_DEBUG_MEMORY=1 enables the 30s heap monitor (see src/main.tsx)
# VITE_DEBUG_KEYS=1 enables key-registry debug logging
# VITE_DEBUG_MEMORY=
# VITE_DEBUG_KEYS=

# Provider Proxy Targets (dev server rewrites /proxy/:provider/*)
# Override defaults in vite.config.ts to route through a custom CORS proxy
VITE_PROXY_GEMINI=https://generativelanguage.googleapis.com
VITE_PROXY_OPENROUTER=https://openrouter.ai
VITE_PROXY_NVIDIA=https://integrate.api.nvidia.com
VITE_PROXY_GROQ=https://api.groq.com/openai/v1
VITE_PROXY_CEREBRAS=https://api.cerebras.ai/v1
VITE_PROXY_CLOUDFLARE=https://api.cloudflare.com/client/v4
VITE_PROXY_OPENAI=https://api.openai.com/v1

# Fetch tool proxy (sandboxed URL fetching)
# Dev: /proxy/fetch routes here; fallback: run: npm run proxy (cors-proxy.mjs on :3002)
# Production: Set to /proxy/fetch relative to your domain
VITE_PROXY_FETCH=http://localhost:3002/fetch

# API upstream (for /api/* routes in dev)
VITE_API_UPSTREAM=https://api.openrouter.ai

# ── API Keys (local dev only) ─────────────────────────────────────────────
# WARNING (S1-08): every VITE_* variable is inlined into the client bundle at
# build time. Never put real keys here for production/shared builds — add keys
# via the app Keys panel instead. (The old scripts/insert-all-keys.ts importer
# no longer exists; unset variables are skipped.)
# VITE_KEY_OPENROUTER_01=
# VITE_KEY_OPENROUTER_02=
# VITE_KEY_GEMINI_01=
# VITE_KEY_GEMINI_02=
# VITE_KEY_GEMINI_03=
# VITE_KEY_GROQ_01=
# VITE_KEY_GROQ_02=
# VITE_KEY_GROQ_03=
# VITE_KEY_NVIDIA_01=
# VITE_KEY_NVIDIA_02=
# VITE_KEY_ANTHROPIC_01= (Claude API key, sk-ant-...; включает computer-use трассу B)
# VITE_KEY_DEEPSEEK_01=
# VITE_KEY_COMETAPI_01=
# VITE_KEY_COHERE_01=
# VITE_KEY_BLACKBOX_01=

# CORS Proxy (for sandboxed tool execution — fallback when direct fetch fails)
# Dev: run: npm run proxy (starts cors-proxy.mjs on port 3002)
# Production: Set to the nginx proxy endpoint (e.g., https://yourdomain.com/proxy/fetch)
# or the docker internal cors-proxy if using the companion service.
# Falls back to /proxy/fetch relative to the serving origin if unset.
VITE_PROXY_URL=http://localhost:3002/fetch

# ── Infrastructure (used by server/ and docker/) ──────────────────────────────
# Sync server WebSocket auth token — REQUIRED in production
# IMPORTANT: Generate a strong random token (e.g. openssl rand -hex 32)
# and NEVER commit it to version control. This is a placeholder only.
SYNC_SECRET=

# Sync server allowed origins (comma-separated)
SYNC_ORIGINS=http://localhost:5173

# W6-024: set to 1 ONLY when sync-server sits behind a proxy that overwrites
# X-Forwarded-For (e.g. nginx). When 1, rate limiting uses the rightmost
# (nearest-proxy) entry; when unset/0 the socket remoteAddress is used so the
# header cannot spoof past rate limits.
SYNC_TRUST_PROXY=0

# CORS proxy allowed origin (used by scripts/cors-proxy.mjs)
CORS_ORIGIN=http://localhost:5173

# ── Phase 70: browser-use (see docs/new/ro2.md §7) ──────────────────────────
# Kill-switch gateway-адаптера `browser-use` (server/adapters.mjs).
# 0 (default) = адаптер отвечает 403; 1 = gateway форвардит задачи на sidecar.
ADAPTERS_ALLOW_BROWSER_USE=0
# Kill-switch gateway-адаптера `computer-act` (action-level, для CUA-loop
# через gateway). Sidecar-URL по умолчанию берётся из BROWSER_USE_ACT_URL
# на стороне gateway (в compose — docker-имя sidecar).
ADAPTERS_ALLOW_COMPUTER_ACT=0
BROWSER_USE_ACT_URL=http://localhost:3100/act
# Sidecar endpoint для прямых вызовов из браузера (BrowserUseService):
# localStorage browserUse.sidecarUrl перекрывает это значение.
VITE_BROWSER_USE_SIDECAR_URL=http://localhost:3100/execute
# Action-level actuator для computer-use loop (Phase 71, SidecarComputerExecutor).
VITE_BROWSER_USE_ACT_URL=http://localhost:3100/act
# Нативный запуск sidecar без скачивания Chromium: системный браузер
# (Windows: BROWSER_USE_CHANNEL=msedge — Edge уже стоит).
# Default (пусто): bundled chromium через `playwright install chromium`.
# BROWSER_USE_CHANNEL=msedge
# Allowlist доменов для browser-задач (comma-separated, пусто = любые публичные http(s)).
# Прокидывается и в sidecar (BROWSER_USE_ALLOWED_DOMAINS), и в adapter config.
BROWSER_USE_ALLOWED_DOMAINS=
# W4-025: сокет sidecar слушает только loopback (127.0.0.1). Меняйте только
# если намеренно ставите sidecar за аутентифицированный шлюз.
# BROWSER_SIDECAR_HOST=127.0.0.1
# W4-025: общий bearer-токен для sidecar. Если задан — каждый запрос (кроме
# /health) обязан нести `Authorization: Bearer <token>`. Клиент должен иметь
# тот же токен в VITE_BROWSER_USE_TOKEN (или localStorage browserUse.token).
# BROWSER_SIDECAR_TOKEN=
# Headless-режим Chromium (1=да, 0=видимое окно для отладки).
# BROWSER_SIDECAR_HEADLESS=1
# Токен клиента для прямых вызовов sidecar (серверный BROWSER_SIDECAR_TOKEN).
# VITE_BROWSER_USE_TOKEN=
# Full-agent режим sidecar (без ключа — fallback navigate+screenshot через Playwright):
# BROWSER_USE_LLM_API_KEY= (для gemini — Google AI Studio key AIza...)
# BROWSER_USE_LLM_PROVIDER=openai (или anthropic, или gemini/google)
# BROWSER_USE_LLM_MODEL=gpt-4o-mini
# BROWSER_USE_LLM_BASE_URL=

# ── Docker / nginx (passed via docker run -e or docker-compose environment) ────
# API upstream (used in nginx /api/ location)
API_UPSTREAM=https://api.openrouter.ai

# Fetch tool proxy in Docker (nginx /proxy/fetch/* routes here)
# SEC-07: REQUIRED in production. Set to your own proxy endpoint.
# Default is empty — nginx will fail closed if not configured.
# PROXY_FETCH=/proxy/fetch

# Per-provider nginx proxy defaults (override at deploy time if needed)
# PROXY_GEMINI=https://generativelanguage.googleapis.com
# PROXY_OPENROUTER=https://openrouter.ai
# PROXY_NVIDIA=https://integrate.api.nvidia.com
# PROXY_GROQ=https://api.groq.com/openai/v1
# PROXY_CEREBRAS=https://api.cerebras.ai/v1
# PROXY_CLOUDFLARE=https://api.cloudflare.com/client/v4
# PROXY_GENERIC=https://api.openai.com
